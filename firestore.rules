rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the patient owner
    function isOwner(patientUid) {
      return isAuthenticated() && request.auth.uid == patientUid;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*@rafah-medical\\.com$')
      );
    }

    // Reports collection security rules
    match /reports/{reportId} {
      // Patients can ONLY read reports where patientId matches their authenticated UID
      // Admins can read, create, update, and delete all reports
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Patients collection
    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Doctors collection
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Services collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}


